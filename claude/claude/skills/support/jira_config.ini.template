# =============================================================================
# jira_config.ini — JIRA WBS Creator Configuration
# =============================================================================
# Copy this file to jira_config.ini and fill in your credentials.
# IMPORTANT: jira_config.ini is gitignored — never commit it.
# =============================================================================

[JIRA]

# Your Atlassian Cloud base URL (no trailing slash)
server = https://your-domain.atlassian.net

# Email address tied to your Atlassian account
email = your-email@example.com

# JIRA API Token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
api_token = your-api-token-here

# JIRA project key (must already exist in JIRA, e.g. CR5, P001, PROJ)
project = YOUR_PROJECT_KEY

# Story points custom field name for your JIRA instance
# Common values: customfield_10016 (Cloud default), customfield_10028, story_points (Server)
story_points_field = customfield_10016

# Task Estimation Time custom field ID (optional, used by [WBS-to-JIRA] and [Worklog])
task_estimation_time_field = customfield_10806

# Daily Worklog Logger — custom field IDs (used by [Worklog])
# AI Contribution: select field, options are "0".."100" (plain numbers)
# %Done: select field, options are "0%".."100%" in 10% steps
# Find field IDs via: curl -u email:token https://your-domain.atlassian.net/rest/api/3/field
ai_contribution_field = customfield_10193
done_pct_field = customfield_10101


[BEHAVIOUR]

# Delay between API calls (seconds) to avoid rate limits
subtask_delay = 0.2
story_delay = 0.3

# Issue type names — must match exactly what your JIRA project uses
# Check: JIRA Project Settings → Issue Types
story_type = Story
subtask_type = Subtask


[LABELS]

# Comma-separated labels applied to all created issues (leave empty for none)
# The project key is always added automatically
extra_labels = wbs-import